# Server Environment & Port
PORT=9900
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Database & Cache
MONGODB_URI=mongodb://localhost:27017/neirah
REDIS_URL=redis://127.0.0.1:6379

# App URLs (CORS, Redirects & Webhooks)
BACKEND_URL=http://localhost:9900
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5175

# Default Providers
PAYMENT_PROVIDER=razorpay
SMS_PROVIDER=netsms
LOGISTICS_PROVIDER=shiprocket
SHIPPING_PROVIDER=shiprocket

# Security & Token Encryption
PAYLOAD_ENCRYPTION_KEY=
INTEGRATION_TOKEN_ENCRYPTION_KEY=

# Cloudflare R2 Object Storage
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_PUBLIC_DOMAIN=
CLOUDFLARE_R2_PUBLIC_URL=

# Shiprocket Logistics
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PICKUP_PINCODE=
SHIPROCKET_MOCK_MODE=false
SHIPROCKET_WEBHOOK_TOKEN=
LOGISTICS_WEBHOOK_TOKEN=
SHIPROCKET_TOKEN_ENCRYPTION_KEY=

# Razorpay Configuration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
TEST_PAYMENT_PHONE_NUMBERS=["9825032534"]

# CCAvenue Configuration
CCAVENUE_MERCHANT_ID=
CCAVENUE_ACCESS_CODE=
CCAVENUE_WORKING_KEY=
CCAVENUE_URL=https://secure.ccavenue.com/transaction/transaction.do?command=initiateTransaction
CCAVENUE_ENVIRONMENT=uat
CCAVENUE_ENCRYPTION_MODE=aes128
CCAVENUE_TEST_AMOUNT=true

# WhatsApp Connect (ConnectWhats)
CONNECTWHATS_API_URL=
CONNECTWHATS_API_KEY=
CONNECTWHATS_TOKEN=
CONNECTWHATS_INSTANCE_ID=
CONNECTWHATS_PHONE_NUMBER=
CONNECTWHATS_PHONE_NUMBER_ID=
CONNECTWHATS_WABA_ID=

# Email (SMTP NodeMailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
STORE_NAME=Neirah
SMTP_FROM=

# SMS Gateway (NetSMS)
NETSMS_API_URL=https://ui.netsms.co.in/API/SendSMS.aspx
NETSMS_API_KEY=
NETSMS_SENDER_ID=NETSMS
NETSMS_SMS_TYPE=TRANS
NETSMS_ENTITY_ID=
NETSMS_OTP_TEMPLATE_ID=
NETSMS_OTP_TEMPLATE="Your OTP for login to Neirah From House Of Zanzar Jeweller Website is {#var#}. It is valid for 5 minutes. Do not share this code with anyone."
SMS_SIGNUP_MESSAGE="Welcome to Neirah! Thank you for signing up with us."
SMS_ORDER_MESSAGE="Thank you for your order on Neirah. Your order {#var#} has been placed successfully."

# International SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Ornate ERP Integration
ORNATE_BASE_URL="http://142.79.228.244:2507/OnlineJewelleryShopping"
ORNATE_USERNAME="admin"
ORNATE_PASSWORD="admin@123"
ORNATE_FTP_HOST="142.79.228.244"
ORNATE_FTP_USER="ecomm"
ORNATE_FTP_PASSWORD="nx@123"
ORNATE_FTP_PORT="2166"
ORNATE_TIMEOUT=30000
ORNATE_SYNC_ENABLED="false"
ORNATE_SYNC_CRON="0 2 * * *"

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://neirah.in/auth/google_callback

# Google Analytics 4 (GA4) Reporting
GA4_PROPERTY_ID=
GA_SERVICE_ACCOUNT_KEY=

# Scheduled Jobs & Crons
OFFER_EXPIRATION_CRON="0 * * * *"
THEME_CRON_ENABLED="true"
