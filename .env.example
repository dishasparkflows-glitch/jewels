# NetSMS adapter. Add the endpoint and request format from your NetSMS account.
SMS_PROVIDER=netsms
NETSMS_API_URL=
NETSMS_HTTP_METHOD=POST
NETSMS_API_KEY=
NETSMS_SENDER_ID=

# Configure JSON to match NetSMS's API contract. Supported tokens:
# {{to}}, {{message}}, {{templateId}}, {{senderId}}, {{apiKey}}, {{variables.name}}, {{variables.orderId}}, {{variables.amount}}
NETSMS_REQUEST_TEMPLATE_JSON=
NETSMS_HEADERS_JSON=

# Use the approved DLT template IDs and exact approved message text.
NETSMS_SIGNUP_TEMPLATE_ID=
NETSMS_ORDER_TEMPLATE_ID=
SMS_SIGNUP_MESSAGE=
SMS_ORDER_MESSAGE=

# ========================================== PAYMENT GATEWAYS
DEFAULT_PAYMENT_GATEWAY=razorpay # 'razorpay' or 'ccavenue'

# Razorpay Configuration
RAZORPAY_KEY_ID=rzp_test_YourKeyId
RAZORPAY_KEY_SECRET=YourRazorpaySecret
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecret

# CCAvenue Configuration
CCAVENUE_MERCHANT_ID=
CCAVENUE_ACCESS_CODE=
CCAVENUE_WORKING_KEY=
CCAVENUE_URL=https://secure.ccavenue.com/transaction/transaction.do?command=initiateTransaction
CCAVENUE_ENVIRONMENT=uat # 'uat' or 'production'
CCAVENUE_ENCRYPTION_MODE=aes128
CCAVENUE_TEST_AMOUNT="false"
